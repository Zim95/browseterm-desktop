# ─────────────────────────────────────────────────────────────────────────────
# browseterm-desktop secrets. Copy this to `env.mk` (gitignored, 0600 recommended)
# and fill in the real values. desktop/config.py reads KEY=value pairs from it as
# a fallback behind an env var of the same name (an env var always wins, so CI or
# a one-off run can override a single value without touching this file).
#
# Format is `KEY=value`, no spaces required around `=`. Lines starting with `#`
# and blank lines are ignored.
# ─────────────────────────────────────────────────────────────────────────────

# Must be byte-identical to Cloud's own CLOUD_INTERNAL_API_TOKEN (SETUP-LOCAL.md step 5).
# Required -- local_stack.check_prerequisites() refuses to run Setup at all without it.
BROWSETERM_CLOUD_INTERNAL_API_TOKEN=CHANGEME_CLOUD_INTERNAL_API_TOKEN

# Docker Hub account the local-stack images are pulled from (docker.io/<name>/<component>:latest).
# REPO_PASSWORD is used by container-maker for `docker login` during Save/snapshot push, AND to
# build the per-user-namespace image-pull secret every CREATE/RESUME needs to pull a private saved
# snapshot. Optional for basic terminal creation; required for Save and for Resuming/Creating
# anything from a saved snapshot.
DOCKER_HUB_REPO_NAME=zim95
DOCKER_HUB_REPO_PASSWORD=CHANGEME_DOCKERHUB_TOKEN

# socket-ssh's `ngrok-agent` sidecar's tunnel token. Optional -- the rest of the local stack works
# without it, but socket-ssh's ngrok-agent container can't start (CreateContainerConfigError) and
# remote tunnel access won't work until this is set.
NGROK_AUTHTOKEN=CHANGEME_NGROK_AUTHTOKEN
